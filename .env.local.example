# PostgreSQL connection string (Prisma Postgres, Neon, etc.)
# Local SQLite is no longer used; Vercel needs a hosted database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# OpenAI API key for Agent Mode (https://platform.openai.com/api-keys)
# Keep this server-side only. Never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Auth.js (https://authjs.dev)
# Generate secret: openssl rand -base64 32
AUTH_SECRET=
# From Google Cloud Console → Credentials → OAuth 2.0 Client ID
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Production must be the Vercel URL. Local can omit this (uses the request host).
# AUTH_URL=http://localhost:3000
