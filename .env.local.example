# OpenAI API key for Agent Mode (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Auth.js (https://authjs.dev) — Google Sign-In only
# Generate secret: openssl rand -base64 32
AUTH_SECRET=
# From Google Cloud Console → Credentials → OAuth 2.0 Client ID
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional local override (defaults to request host)
# AUTH_URL=http://localhost:3000
